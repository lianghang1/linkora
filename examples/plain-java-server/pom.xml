<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.linkora</groupId>
        <artifactId>linkora-examples</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>linkora-example-plain-java-server</artifactId>
    <packaging>jar</packaging>

    <name>Linkora Example: Plain Java Server</name>
    <description>普通 Java 服务端示例：嵌入式 Jetty + H2 文件库 + LinkoraServer 完整编排。</description>

    <dependencies>
        <dependency>
            <groupId>com.linkora</groupId>
            <artifactId>linkora-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.linkora</groupId>
            <artifactId>linkora-server-storage-jdbc</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 示例独立运行需要 servlet-api 在运行时类路径（生产中由宿主容器提供） -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <scope>compile</scope>
        </dependency>
        <!-- 示例运行时容器：Jetty 仅为演示便利，生产环境应嵌入宿主已有 Servlet 容器 -->
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-server</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-servlet</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>compile</scope>
        </dependency>
        <!-- 示例需要自带日志实现，宿主环境通常已有 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>
</project>
