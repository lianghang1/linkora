<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.lianghang1</groupId>
        <artifactId>linkora-examples</artifactId>
        <version>0.4.1</version>
    </parent>

    <artifactId>linkora-example-tx-client</artifactId>
    <packaging>jar</packaging>

    <name>Linkora Example: TX Client (Host Transaction Takeover, No SQLite)</name>
    <description>客户端宿主事务接管示例：自实现 ClientStore 接 H2 业务库，outbox 与业务同事务，演示回滚联动与提交后正常发送。</description>

    <dependencies>
        <dependency>
            <groupId>io.github.lianghang1</groupId>
            <artifactId>linkora-client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 对端真实服务端（仅示例便利） -->
        <dependency>
            <groupId>io.github.lianghang1</groupId>
            <artifactId>linkora-testkit</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- testkit 内嵌 Jetty 容器依赖（示例便利，生产无关） -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-server</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-servlet</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <!-- TransactionAwareDataSourceProxy 位于 spring-jdbc -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>
</project>
