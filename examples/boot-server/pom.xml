<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 独立 pom（无父级）：模拟真实宿主项目，直接引用 Maven Central 已发布的 linkora 正式包，
         可脱离本仓库单独构建（mvn -f 本文件），用于验证发布产物的可用性 -->
    <groupId>io.github.lianghang1</groupId>
    <artifactId>linkora-example-spring-boot-server-app</artifactId>
    <version>0.6.0</version>
    <packaging>jar</packaging>

    <name>Linkora Example: Spring Boot Server App</name>
    <description>Spring Boot 服务端宿主：仅提供 DataSource 与 application.yml，linkora-spring-boot-starter 完成其余装配。</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <maven.compiler.release>8</maven.compiler.release>
        <!-- 固定引用已发布的正式版；升级示例依赖时仅需改此属性（联调 SNAPSHOT 先 mvn install） -->
        <linkora.version>0.6.0</linkora.version>
        <!-- 独立 pom 不继承 examples 聚合的该属性：maven-deploy-plugin 识别它，
             防止 deploy 时把示例推往 settings.xml altDeploymentRepository 指向的公司 nexus -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <spring-boot.version>2.7.18</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.lianghang1</groupId>
            <artifactId>linkora-server-spring-boot-starter</artifactId>
            <version>${linkora.version}</version>
        </dependency>
        <!-- 嵌入式运维控制台（可选模块）：演示开启方式 -->
        <dependency>
            <groupId>io.github.lianghang1</groupId>
            <artifactId>linkora-admin-console</artifactId>
            <version>${linkora.version}</version>
        </dependency>
        <!-- 显式锁定 SQLite 驱动版本：Boot BOM 锁的是 3.36，会压制 linkora 传递的
             3.46（内嵌 SQLite 模式需要；事务内并发写场景两版行为有差异） -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.3</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.lianghang1</groupId>
            <artifactId>linkora-testkit</artifactId>
            <version>${linkora.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>2.22.2</version>
                <configuration>
                    <!-- spring-boot repackage 会把主 artifact 替换为 fat jar；
                         显式指回 classes 目录，避免 failsafe 运行时 NoClassDefFoundError -->
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
