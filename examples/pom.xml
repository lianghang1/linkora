<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.lianghang1</groupId>
        <artifactId>linkora-parent</artifactId>
        <version>0.6.0</version>
    </parent>

    <artifactId>linkora-examples</artifactId>
    <packaging>pom</packaging>

    <name>Linkora Examples</name>
    <description>全套示例（Spring Boot / Spring MVC，各含 sqlite 与 datasource 两种存储模式）。
        boot-* 三个走仓库源码；mvc-* 两个为独立 pom（模拟真实宿主），固定引用
        Maven Central 已发布的 linkora 正式包，可单独构建验证发布产物。</description>

    <!-- 示例模块不发布到 Maven Central（release profile 的 deploy/上传均跳过） -->
    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <!-- 四个示例应用；linkora-testkit 位于仓库顶层（测试基建，非示例） -->
    <modules>
        <module>boot-server</module>
        <module>boot-client</module>
        <module>mvc-server</module>
        <module>mvc-client</module>
    </modules>

    <build>
        <plugins>
            <!-- 集成测试（*IT）在 verify 阶段运行；日常 mvn test 不受影响 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>2.22.2</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
