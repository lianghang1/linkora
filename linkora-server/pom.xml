<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.lianghang1</groupId>
        <artifactId>linkora-parent</artifactId>
        <version>0.3.0</version>
    </parent>

    <artifactId>linkora-server</artifactId>
    <packaging>jar</packaging>

    <name>Linkora Server</name>
    <description>服务端编排：JDBC 持久化、先持久化后推送、重连补发、重试调度、消息接入与 ACK 状态机。</description>

    <dependencies>
        <dependency>
            <groupId>io.github.lianghang1</groupId>
            <artifactId>linkora-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- Servlet 端点适配随服务端编排一并发布；容器由宿主提供 -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 测试依赖：H2 + Jetty 用于端到端验证；MySQL 真实库回归见 JdbcServerStorageMySqlIT（生产由宿主提供数据库与容器） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-servlet</artifactId>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-sse</artifactId>
        </dependency>
        <!-- MySQL 8 真实库回归（JdbcServerStorageMySqlIT），仅测试作用域 -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.33</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
        </dependency>
    </dependencies>
</project>
