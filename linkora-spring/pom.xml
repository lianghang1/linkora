<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.lianghang1</groupId>
        <artifactId>linkora-parent</artifactId>
        <version>0.4.2</version>
    </parent>

    <artifactId>linkora-spring</artifactId>
    <packaging>jar</packaging>

    <name>Linkora Spring</name>
    <description>Spring MVC 宿主装配辅助：从容器 SPI bean 组装 LinkoraServer，并把三个端点 Servlet 注册进任意 ServletContext；按需启用 LinkoraClient 客户端装配（不依赖 Spring Boot）。含服务端 JDBC 与客户端 SQLite 默认存储（随 server/client 传递），宿主可换自实现。</description>

    <dependencies>
        <dependency>
            <groupId>io.github.lianghang1</groupId>
            <artifactId>linkora-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 客户端编排（含 OkHttp 传输与 SQLite 存储）：客户端装配（@Import 显式启用）所需 -->
        <dependency>
            <groupId>io.github.lianghang1</groupId>
            <artifactId>linkora-client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <!-- 事务感知数据源包装（TxAwareDataSources）：两端 publish 同事务共用 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>
        <!-- 装配辅助只触碰 ServletContext 注册 API，容器由宿主提供 -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-servlet</artifactId>
        </dependency>
    </dependencies>
</project>
