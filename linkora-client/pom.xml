<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.lianghang1</groupId>
        <artifactId>linkora-parent</artifactId>
        <version>0.5.0</version>
    </parent>

    <artifactId>linkora-client</artifactId>
    <packaging>jar</packaging>

    <name>Linkora Client</name>
    <description>客户端编排：OkHttp 传输（SSE 下行 + POST 上行）、SQLite 本地存储、ACK 流程、断网补传与监听器分发。</description>

    <dependencies>
        <dependency>
            <groupId>io.github.lianghang1</groupId>
            <artifactId>linkora-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- SQLite 本地默认存储（含 native 库）；宿主可换自实现 ClientStore 排除此实现 -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>
        <!-- OkHttp 传输层（SSE 下行 + HTTPS POST 上行），版本由父 pom 锁定 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-sse</artifactId>
        </dependency>
        <!-- 测试依赖：Jetty 服务端用于端到端验证 -->
        <dependency>
            <groupId>io.github.lianghang1</groupId>
            <artifactId>linkora-server</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-servlet</artifactId>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
        </dependency>
    </dependencies>
</project>
