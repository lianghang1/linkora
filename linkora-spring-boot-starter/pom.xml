<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.lianghang1</groupId>
        <artifactId>linkora-parent</artifactId>
        <version>0.4.1</version>
    </parent>

    <artifactId>linkora-spring-boot-starter</artifactId>
    <packaging>jar</packaging>

    <name>Linkora Spring Boot Starter</name>
    <description>Spring Boot 2.7 自动装配：宿主提供 DataSource 即获得 LinkoraServer 与三端点 Servlet；可配置客户端自动接入。存储实现与客户端存储均允许宿主 bean 覆盖。</description>

    <dependencies>
        <!-- 复用 linkora-spring 的服务端装配核心（LinkoraServerAssembler），传递 linkora-server 与 JDBC 存储 -->
        <dependency>
            <groupId>io.github.lianghang1</groupId>
            <artifactId>linkora-spring</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 客户端编排（含 OkHttp 传输与 SQLite 存储）：引入 starter 即获得客户端完整能力（宿主可换自实现 ClientStore） -->
        <dependency>
            <groupId>io.github.lianghang1</groupId>
            <artifactId>linkora-client</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 运维控制台（可选模块）：宿主显式引入依赖 + enabled=true 才装配；optional 保证默认不传递 -->
        <dependency>
            <groupId>io.github.lianghang1</groupId>
            <artifactId>linkora-admin-console</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- ServletRegistrationBean 泛型签名需要 servlet-api 类型；容器由宿主提供 -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.lianghang1</groupId>
            <artifactId>linkora-testkit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
    </dependencies>
</project>
